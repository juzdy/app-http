{
    "name": "juzdy/app-http",
    "description": "The JUZDY HHTP Application",
    "keywords": [
        "php",
        "juzdy",
        "http",
        "app"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Victor Galitsky",
            "email": "concept.galitsky@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "juzdy/app": "dev-main",
        "juzdy/config": "dev-main",
        "juzdy/container": "dev-main",
        "juzdy/event-bus": "dev-main",
        "juzdy/debug": "dev-main",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Juzdy\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {}
    },
    "extra": {
        "juzdy": {
            "config": "etc/config"
        }
    },
    "config": {}
}
